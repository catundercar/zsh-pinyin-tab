#autoload
# 把内存里的名字索引落盘。
#
# 必须用 assoc+=( 键 值 ) 这种形式，不能写成 assoc['键']=值：zsh 不
# 会剥掉关联数组下标里的引号，'文档' 和 文档 会变成两个不同的键，
# 结果是缓存文件看着有内容、读回来一条都对不上。
#
# 整体重写而不是追加——文件通常只有几百条，重写省掉了多 shell 并发
# 时的重复条目问题，配合 mv 也是原子的。

(( _zpt_dirty )) || return 0
[[ -n $ZPT_CACHE_DIR ]] || return 1

local dir=$ZPT_CACHE_DIR
[[ -d $dir ]] || mkdir -p $dir 2>/dev/null || return 1

local f=$dir/names.zsh
local tmp=$f.$$
{
  local k
  for k in ${(k)_zpt_syl}; do
    print -r -- "_zpt_syl+=( ${(qq)k} ${(qq)_zpt_syl[$k]} )"
    print -r -- "_zpt_ini+=( ${(qq)k} ${(qq)_zpt_ini[$k]} )"
    print -r -- "_zpt_ful+=( ${(qq)k} ${(qq)_zpt_ful[$k]} )"
    print -r -- "_zpt_first+=( ${(qq)k} ${(qq)_zpt_first[$k]} )"
  done
} > $tmp 2>/dev/null && mv -f $tmp $f 2>/dev/null

_zpt_dirty=0
return 0
